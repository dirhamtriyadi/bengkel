APP_ENV=development
APP_NAME=BengkelOS

# Port internal proses Go. Jangan ubah untuk mengganti port publik Docker.
HTTP_PORT=8080

# Port yang dipublikasikan pada host/server. Sisi internal tetap 5432/8080/3000.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# DATABASE_URL ini dipakai saat menjalankan Go/Makefile langsung dari host.
# Service Docker memakai alamat internal postgres:5432 yang dikunci di Compose.
DATABASE_URL=postgres://bengkel:bengkel@localhost:5432/bengkel?sslmode=disable
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-with-another-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
FRONTEND_URL=http://localhost:3000
