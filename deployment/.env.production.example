APP_ENV=production
APP_NAME=BengkelOS

# Port internal container; jangan diubah mengikuti port publik/reverse proxy.
HTTP_PORT=8080
POSTGRES_DB=bengkel
POSTGRES_USER=bengkel
POSTGRES_PASSWORD=replace-with-a-strong-password

# Koneksi antarkontainer selalu menggunakan service name postgres dan port 5432.
DATABASE_URL=postgres://bengkel:replace-with-a-strong-password@postgres:5432/bengkel?sslmode=disable
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ORIGINS=https://app.example.com
TRUSTED_PROXIES=172.16.0.0/12
FRONTEND_URL=https://app.example.com
# Origin frontend ke API; jangan tambahkan /api/v1.
API_ORIGIN=http://api:8080
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
